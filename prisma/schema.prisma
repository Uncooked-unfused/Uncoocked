// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(cuid())
  role            String         @default("User")
  permissions     String?        // JSON array: ["USERS_READ", "HOSTS_REVIEW", "EVENTS_MODERATE", etc.]
  name            String?
  fullName        String?
  email           String?        @unique
  notifications   Notification[]
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  dob             String?
  department      String?
  clubAssociation String?
  portfolioUrl    String?
  interests       String?        // JSON serialized array of interests
  bio             String?
  team            String?
  preferenceScore Float          @default(0)
  onboardingCompleted Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil       DateTime?
  createdAt       DateTime       @default(now())
  registrations   Registration[]
  activities      UserActivity[]
  organizedEvents Event[]        @relation("OrganizedEvents")
  managedEvents   EventManager[]
  hostApplication HostApplication?
  supportTickets  SupportTicket[]
  communicationRecipients CommunicationRecipient[]

  @@index([role])
}

model Event {
  id              String           @id // e.g. hackathon-2026
  title           String
  type            String // Fest, Party, Hackathon, etc.
  category        String?
  tags            String? // JSON string
  keywords        String? // JSON string
  popularityScore Float            @default(0)
  date            DateTime
  location        String
  zone            String?
  city            String           @default("Lucknow")
  state           String           @default("Uttar Pradesh")
  country         String           @default("India")
  description     String
  schedule        String? // Markdown
  prizePool       String? // Markdown
  bannerUrl       String?
  googleMapsUrl   String?
  ticketType      String           @default("Free") // Free, Paid
  price           Float?
  capacity        Int
  waitlistEnabled Boolean          @default(false)
  archived        Boolean          @default(false)
  status          String           @default("Active") // Active or Completed
  customRegistrationCount Int?
  customOrganizerName     String?
  createdAt       DateTime         @default(now())
  
  organizerId     String?
  organizer       User?            @relation("OrganizedEvents", fields: [organizerId], references: [id])

  registrations   Registration[]
  bulletinUpdates BulletinUpdate[]
  activities      UserActivity[]
  ticketTiers     TicketTier[]
  coupons         Coupon[]
  analytics       EventAnalytic[]
  managers        EventManager[]
  activityLogs    EventActivityLog[]

  @@index([status])
  @@index([archived])
  @@index([organizerId])
}

model TicketTier {
  id          String   @id @default(uuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  name        String
  price       Float    @default(0)
  capacity    Int?
  soldCount   Int      @default(0)
  description String?
  registrations Registration[]

  @@index([eventId])
}

model Coupon {
  id          String   @id @default(uuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  code        String
  discountPct Float
  maxUses     Int?
  currentUses Int      @default(0)
  registrations Registration[]

  @@index([eventId])
}

model Registration {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String
  
  ticketTier   TicketTier? @relation(fields: [ticketTierId], references: [id])
  ticketTierId String?
  
  coupon       Coupon?     @relation(fields: [couponId], references: [id])
  couponId     String?
  
  status       String   @default("Pending") // Pending, Confirmed, Checked In
  checkInStatus Boolean  @default(false)
  teamName     String?
  track        String?
  registeredAt DateTime @default(now())
  logs         RegistrationLog[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model BulletinUpdate {
  id       String   @id @default(uuid())
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  title    String
  content  String
  postedAt DateTime @default(now())

  @@index([eventId])
}

model UserActivity {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  interactionType String   // VIEW, SAVE, REGISTER
  timestamp       DateTime @default(now())

  @@index([userId])
  @@index([eventId])
}

model EventAnalytic {
  id             String   @id @default(uuid())
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  date           DateTime @default(now())
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  registrations  Int      @default(0)
  attendance     Int      @default(0)
  revenue        Float    @default(0)

  @@unique([eventId, date])
  @@index([eventId])
}

model EventManager {
  id              String   @id @default(uuid())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  role            String   @default("Admin")
  addedAt         DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model RegistrationLog {
  id              String   @id @default(uuid())
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId  String
  action          String
  oldStatus       String?
  newStatus       String?
  timestamp       DateTime @default(now())
  performedBy     String?

  @@index([registrationId])
}

model EventActivityLog {
  id              String   @id @default(uuid())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  action          String
  details         String?
  performedBy     String
  timestamp       DateTime @default(now())

  @@index([eventId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  eventId   String
  userName  String
  userEmail String
  message   String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userName  String
  userEmail String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model HostApplication {
  id               String                @id @default(cuid())
  userId           String                @unique
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String
  organizationType String
  organizationEmail String?
  website          String?
  address          String?
  description      String?

  status           String                @default("PENDING")
  assignedAdminId  String?
  rejectionReason  String?
  infoRequestedReason String?

  kycProvider      String?
  kycReferenceId   String?
  kycStatus        String?
  documentUrls     String?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  notes            AdminNote[]
  auditLogs        AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model AdminNote {
  id            String          @id @default(cuid())
  applicationId String
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminId       String
  note          String
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

model AuditLog {
  id            String           @id @default(cuid())
  applicationId String?
  application   HostApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  adminId       String
  action        String
  previousStatus String?
  newStatus     String?
  reason        String?
  ipAddress     String?
  timestamp     DateTime         @default(now())

  @@index([action])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model SystemSetting {
  key         String   @id
  value       String
  type        String   @default("BOOLEAN")
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model SystemTelemetrySnapshot {
  id            String   @id @default(cuid())
  cpuUsagePct   Float
  memUsagePct   Float
  apiLatencyP95 Int
  dbLatencyMs   Int
  activeUsers   Int      @default(0)
  errorRatePct  Float    @default(0)
  timestamp     DateTime @default(now())

  @@index([timestamp])
}

model PlatformIncident {
  id           String    @id @default(cuid())
  title        String
  severity     String    // SEV1_CRITICAL, SEV2_MAJOR, SEV3_MINOR
  status       String    // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED
  summary      String
  affectedArea String    // PAYMENTS, HOSTING, EVENTS, AUTH
  declaredBy   String
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([status, severity])
  @@index([createdAt])
}

model SupportTicket {
  id              String          @id @default(cuid())
  subject         String
  category        String          // ACCOUNT, HOSTING, EVENT, PAYMENT, GENERAL
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String          @default("OPEN") // OPEN, IN_PROGRESS, WAITING_ON_USER, RESOLVED, CLOSED

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAdminId String?
  eventId         String?
  hostAppId       String?

  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([userId, status])
  @@index([category, priority])
}


model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  isInternal Boolean       @default(false)
  content    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model AdminCommunication {
  id              String   @id @default(cuid())
  subject         String
  message         String
  type            String   @default("NOTIFICATION") // NOTIFICATION | DOCUMENT_REQUEST | MEDIA_REQUEST
  targetType      String   @default("INDIVIDUAL")   // INDIVIDUAL | GROUP
  targetGroup     String?  // ALL_USERS | ORGANIZERS | PENDING_HOSTS | VERIFIED_HOSTS | ATTENDEES | CUSTOM
  requiredDocType String?  // e.g. "Identity Proof", "Event Contract", "Banner Media", "College Authorization"
  instructions    String?
  priority        String   @default("NORMAL")       // NORMAL | HIGH | URGENT
  deadline        DateTime?
  sentBy          String   // Admin user ID
  createdAt       DateTime @default(now())

  recipients      CommunicationRecipient[]

  @@index([type])
  @@index([targetType])
  @@index([createdAt])
}

model CommunicationRecipient {
  id                String             @id @default(cuid())
  communicationId   String
  communication     AdminCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  email             String
  status            String             @default("SENT") // SENT | DELIVERED | VIEWED | RESPONDED
  
  // User response payload (shown in Admin Panel only)
  responseNotes     String?
  documentUrl       String?            // Link to drive/storage/document
  mediaUrls         String?            // JSON array of media URLs / uploaded files
  respondedAt       DateTime?
  adminReviewStatus String             @default("PENDING") // PENDING | REVIEWED | APPROVED | REJECTED | FOLLOW_UP_REQUIRED
  adminReviewNotes  String?
  reviewedBy        String?
  reviewedAt        DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([communicationId])
  @@index([userId])
  @@index([status])
  @@index([adminReviewStatus])
}

model Opportunity {
  id           String                   @id @default(cuid())
  title        String
  company      String
  type         String                   @default("Full-time") // Internship, Bounty, Full-time, Freelance, Part-time, Contract
  location     String                   @default("Remote")
  salary       String?                  // e.g. "₹20/hr", "₹80k - ₹100k", "₹500 - ₹2000"
  description  String
  tags         String                   @default("[]") // JSON array string or comma separated
  requirements String?
  applyLink    String?
  status       String                   @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  featured     Boolean                  @default(false)
  postedBy     String?                  // Admin ID or Organizer
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  applications OpportunityApplication[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String?
  fullName      String
  email         String
  phone         String?
  role          String
  message       String?
  resumeName    String?
  resumeUrl     String?
  status        String      @default("PENDING") // PENDING, REVIEWING, SHORTLISTED, REJECTED, ACCEPTED
  adminNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}
